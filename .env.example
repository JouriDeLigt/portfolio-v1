# Contact form mail via Brevo's transactional API (Hoort's Brevo account > SMTP & API > API keys)
BREVO_API_KEY=
# Optional: validate requests at Brevo without sending anything, e.g. for Vercel previews
# BREVO_SANDBOX=true

# Cloudflare Turnstile. Without these, dev uses Cloudflare's test keys.
# The site key must be set at build time: the pages are prerendered.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=
